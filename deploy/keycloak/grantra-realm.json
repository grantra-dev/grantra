{
  "realm": "grantra",
  "enabled": true,
  "displayName": "Grantra Login",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "grantra-console",
      "name": "Grantra console",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "grantra-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:8080/auth/callback", "http://localhost:5173/auth/callback"],
      "webOrigins": ["http://localhost:8080", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*"
      }
    }
  ],
  "roles": {
    "realm": [
      { "name": "grantra-admin", "description": "Full administrative access to Grantra" },
      { "name": "grantra-auditor", "description": "Read-only access to identities and audit logs" }
    ]
  },
