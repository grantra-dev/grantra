// Entities and actions the console API authorizes. Policies in this directory
// are validated against this schema in the tests.

// A platform role: grantra-admin, grantra-helpdesk or grantra-auditor.
entity Role;

// A person or service. Membership in a Role means holding that platform role.
entity Identity in [Role] {
  status: String,
  kind: String,
  manager?: Identity,
};

// The list of all identities of the tenant.
entity Directory;

// The tenant's audit log.
entity AuditLog;

// The tenant's identity sources (HR feeds) and the joiner, mover and leaver
// events they produce.
entity Lifecycle;

// The catalog of applications, entitlements and business roles, and the
// birthright rules that give them out.
entity Catalog;

// Every access request of the tenant.
entity Requests;

// One access request. approvers are everyone asked to approve it;
// current_approvers may decide the step it waits on (empty: an admin).
entity AccessRequest {
  requester: Identity,
  beneficiary: Identity,
  approvers: Set<Identity>,
  current_approvers: Set<Identity>,
};

// The tenant's access review campaigns.
entity Reviews;

// One access to review: whose it is, and who may review it (empty: an
// admin).
entity ReviewItem {
  identity: Identity,
  reviewers: Set<Identity>,
};

// The tenant's separation of duties policies and their violations.
entity SoD;

// Action groups.
action "read";
action "write";

action "identity.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Identity,
  context: {},
};

action "identity.list" in ["read"] appliesTo {
  principal: Identity,
  resource: Directory,
  context: {},
};

action "audit.read" in ["read"] appliesTo {
  principal: Identity,
  resource: AuditLog,
  context: {},
};

action "platform_role.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Role,
  context: {},
};

// target is the identity receiving or losing the role.
action "platform_role.grant", "platform_role.revoke" in ["write"] appliesTo {
  principal: Identity,
  resource: Role,
  context: { target: Identity },
};

action "identity_source.read", "lifecycle_event.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Lifecycle,
  context: {},
};

// manage creates sources; sync feeds one and applies what changed.
action "identity_source.manage", "identity_source.sync" in ["write"] appliesTo {
  principal: Identity,
  resource: Lifecycle,
  context: {},
};

action "catalog.read", "access_rule.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Catalog,
  context: {},
};

action "catalog.manage", "access_rule.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Catalog,
  context: {},
};

// What people can ask for: roles and entitlements outside the built-in
// application.
action "requestable.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Catalog,
  context: {},
};

// resource is the person who would get the access.
action "access_request.create" in ["write"] appliesTo {
  principal: Identity,
  resource: Identity,
  context: {},
};

action "access_request.read" in ["read"] appliesTo {
  principal: Identity,
  resource: AccessRequest,
  context: {},
};

action "access_request.list" in ["read"] appliesTo {
  principal: Identity,
  resource: Requests,
  context: {},
};

action "access_request.decide", "access_request.cancel" in ["write"] appliesTo {
  principal: Identity,
  resource: AccessRequest,
  context: {},
};

action "review_campaign.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Reviews,
  context: {},
};

action "review_campaign.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Reviews,
  context: {},
};

action "review_item.decide" in ["write"] appliesTo {
  principal: Identity,
  resource: ReviewItem,
  context: {},
};

// manage writes policies, runs scans and grants exceptions.
action "sod.read" in ["read"] appliesTo {
  principal: Identity,
  resource: SoD,
  context: {},
};

action "sod.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: SoD,
  context: {},
};
