// Entities and actions the console API authorizes. Policies in this directory
// are validated against this schema in the tests.

// A platform role: grantra-admin, grantra-helpdesk or grantra-auditor.
entity Role;

// A person or service. Membership in a Role means holding that platform role.
entity Identity in [Role] {
  status: String,
  kind: String,
  manager?: Identity,
};

// The list of all identities of the tenant.
entity Directory;

// The tenant's audit log.
entity AuditLog;

// The tenant's identity sources (HR feeds) and the joiner, mover and leaver
// events they produce.
entity Lifecycle;

// The tokens scripts and scheduled jobs use to feed Grantra.
entity ServiceTokens;

// The parts of Grantra the tenant shows in the console, such as privileged
// access or Grantra Login.
entity Modules;

// The catalog of applications, entitlements and business roles, and the
// birthright rules that give them out.
entity Catalog;

// Every access request of the tenant.
entity Requests;

// One access request. approvers are everyone asked to approve it;
// current_approvers may decide the step it waits on (empty: an admin).
entity AccessRequest {
  requester: Identity,
  beneficiary: Identity,
  approvers: Set<Identity>,
  current_approvers: Set<Identity>,
};

// The tenant's access review campaigns.
entity Reviews;

// One access to review: whose it is, and who may review it (empty: an
// admin).
entity ReviewItem {
  identity: Identity,
  reviewers: Set<Identity>,
};

// The tenant's separation of duties policies and their violations.
entity SoD;

// Threat detection: sign-ins, alerts and the detections' settings.
entity Threats;

// One threat alert, and who it is about (none for an address).
entity ThreatAlert {
  identity?: Identity,
};

// Grantra Login: its apps and sign-in policy.
entity Login;

// The credential vault.
entity Vault;

// One vault account: holders hold access to it right now.
entity VaultAccount {
  holders: Set<Identity>,
};

// A break-glass vault account and who may open it in an emergency.
entity BreakGlassAccount {
  responders: Set<Identity>,
};

// One break-glass use of a vault account, to review afterwards.
entity BreakGlassUse {
  identity: Identity,
};

// One SSH target: holders hold access to it right now.
entity SSHTarget {
  holders: Set<Identity>,
};

// One cluster or database behind the gateway: holders hold access to it
// right now.
entity GatewayTarget {
  holders: Set<Identity>,
};

// Action groups.
action "read";
action "write";

action "identity.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Identity,
  context: {},
};

action "identity.list" in ["read"] appliesTo {
  principal: Identity,
  resource: Directory,
  context: {},
};

action "audit.read" in ["read"] appliesTo {
  principal: Identity,
  resource: AuditLog,
  context: {},
};

action "platform_role.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Role,
  context: {},
};

// target is the identity receiving or losing the role.
action "platform_role.grant", "platform_role.revoke" in ["write"] appliesTo {
  principal: Identity,
  resource: Role,
  context: { target: Identity },
};

action "identity_source.read", "lifecycle_event.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Lifecycle,
  context: {},
};

// manage creates sources; sync feeds one and applies what changed.
action "identity_source.manage", "identity_source.sync" in ["write"] appliesTo {
  principal: Identity,
  resource: Lifecycle,
  context: {},
};

action "catalog.read", "access_rule.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Catalog,
  context: {},
};

action "catalog.manage", "access_rule.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Catalog,
  context: {},
};

// What people can ask for: roles and entitlements outside the built-in
// application.
action "requestable.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Catalog,
  context: {},
};

// resource is the person who would get the access.
action "access_request.create" in ["write"] appliesTo {
  principal: Identity,
  resource: Identity,
  context: {},
};

action "access_request.read" in ["read"] appliesTo {
  principal: Identity,
  resource: AccessRequest,
  context: {},
};

action "access_request.list" in ["read"] appliesTo {
  principal: Identity,
  resource: Requests,
  context: {},
};

action "access_request.decide", "access_request.cancel" in ["write"] appliesTo {
  principal: Identity,
  resource: AccessRequest,
  context: {},
};

action "review_campaign.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Reviews,
  context: {},
};

action "review_campaign.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Reviews,
  context: {},
};

action "review_item.decide" in ["write"] appliesTo {
  principal: Identity,
  resource: ReviewItem,
  context: {},
};

// manage writes policies, runs scans and grants exceptions.
action "sod.read" in ["read"] appliesTo {
  principal: Identity,
  resource: SoD,
  context: {},
};

action "sod.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: SoD,
  context: {},
};

// manage sets up detections, runs scans and takes sign-ins from scripts.
action "threat.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Threats,
  context: {},
};

action "threat.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Threats,
  context: {},
};

// Ending someone's sessions, requiring them a second factor, suspending or
// reinstating them; the resource is that person.
action "threat.respond" in ["write"] appliesTo {
  principal: Identity,
  resource: Identity,
  context: {},
};

action "threat_alert.close" in ["write"] appliesTo {
  principal: Identity,
  resource: ThreatAlert,
  context: {},
};

// manage registers apps, rotates their secrets and sets the sign-in policy.
action "login.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Login,
  context: {},
};

action "login.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Login,
  context: {},
};

// manage adds vault accounts, sets and rotates their secrets and ends
// check-outs; read sees them, their history and discovery, never a secret.
action "vault.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Vault,
  context: {},
};

action "vault.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Vault,
  context: {},
};

// checkout reveals the secret.
action "vault_account.checkout" in ["write"] appliesTo {
  principal: Identity,
  resource: VaultAccount,
  context: {},
};

// break_glass opens a break-glass account without approval.
action "vault_account.break_glass" in ["write"] appliesTo {
  principal: Identity,
  resource: BreakGlassAccount,
  context: {},
};

// connect signs an SSH certificate for a target. SSH targets, sessions,
// recordings and commands are managed and read with vault.manage and
// vault.read.
action "ssh_target.connect" in ["write"] appliesTo {
  principal: Identity,
  resource: SSHTarget,
  context: {},
};

// connect issues a token for a cluster or database behind the gateway.
// Targets, sessions and their logs are managed and read with vault.manage
// and vault.read.
action "gateway_target.connect" in ["write"] appliesTo {
  principal: Identity,
  resource: GatewayTarget,
  context: {},
};

// review confirms a break-glass use was justified, or flags it.
action "break_glass_use.review" in ["write"] appliesTo {
  principal: Identity,
  resource: BreakGlassUse,
  context: {},
};

// manage makes people eligible for access, takes eligibility away and turns
// standing access into eligibility; the resource is the person.
action "access.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Identity,
  context: {},
};

// activate turns one's own eligibility into access for a few hours; the
// resource is the eligible person.
action "access.activate" in ["write"] appliesTo {
  principal: Identity,
  resource: Identity,
  context: {},
};

// manage creates and revokes the tokens scripts use to feed HR sources and
// account files without a person signing in.
action "service_token.read" in ["read"] appliesTo {
  principal: Identity,
  resource: ServiceTokens,
  context: {},
};

action "service_token.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: ServiceTokens,
  context: {},
};

// manage turns parts of Grantra on or off in the console for the tenant.
action "module.read" in ["read"] appliesTo {
  principal: Identity,
  resource: Modules,
  context: {},
};

action "module.manage" in ["write"] appliesTo {
  principal: Identity,
  resource: Modules,
  context: {},
};
